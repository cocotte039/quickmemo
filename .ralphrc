# =============================================================================
# .ralphrc -- Python + uv プロジェクト向けプリセット
#
# 目的:
#   Python + uv でパッケージ管理するプロジェクト向けに
#   最適化された loop.sh の設定ファイルです。
#   品質ゲートに ruff (lint + format check) が設定済みです。
#
# 使い方:
#   プロジェクトルート直下にコピーしてください。
#   loop.sh 起動時に自動的に source されます。
#
# カスタマイズ:
#   - テストがある場合: QUALITY_GATE_COMMAND に pytest を追加
#   - mypy を使う場合: QUALITY_GATE_COMMAND に mypy を追加
#   - 詳細は各設定項目のコメントを参照
#
# 配置場所:
#   /path/to/your-project/.ralphrc
# =============================================================================

# ---------------------------------------------------------------------------
# ループエンジン設定
# ---------------------------------------------------------------------------

# 最大反復数
# Python プロジェクトは型エラーや lint 修正で反復が増えやすいため、
# 10 回を初期値とする。大規模プロジェクトでは 15-20 に増やすことを検討。
MAX_ITERATIONS=10

# 全体タイムアウト（時間単位）
# uv sync + pytest + ruff の実行時間を考慮して 4 時間を設定。
TIMEOUT_HOURS=4

# Claude のモデル指定
# 推奨: コスト効率の観点から sonnet を初期値とする。
# 選択肢: haiku, sonnet, opus
CLAUDE_MODEL=sonnet

# ---------------------------------------------------------------------------
# 品質ゲート（Python + uv 向け）
# ---------------------------------------------------------------------------

# 品質ゲートの有効/無効
# ruff が設定済みのプロジェクトでは true にすることを推奨。
QUALITY_GATE_ENABLED=false

# 品質ゲートのコマンド
# ruff check (lint) と ruff format --check (format 確認) を実行する。
# 0 で終了すれば PASS、非0 で終了すれば FAIL。
QUALITY_GATE_COMMAND="uv run ruff check . && uv run ruff format --check ."

# テストがある場合は以下に変更:
# QUALITY_GATE_COMMAND="uv run pytest && uv run ruff check . && uv run ruff format --check ."

# mypy も含める場合:
# QUALITY_GATE_COMMAND="uv run pytest && uv run ruff check . && uv run ruff format --check . && uv run mypy ."

# ---------------------------------------------------------------------------
# 安全機構
# ---------------------------------------------------------------------------

# サーキットブレーカー閾値
# 同一エラーがこの回数連続で検出されるとループを自動停止する。
# Python の型エラーや import エラーは同じメッセージが繰り返されやすいため、
# 3 回で停止して人間の介入を促す。
CIRCUIT_BREAKER_THRESHOLD=3

# レートリミット（1時間あたりの最大呼び出し回数）
# 現時点では loop.sh 側での制御は未実装。
# Claude API 側のレートリミットも別途適用される。
RATE_LIMIT_PER_HOUR=100

# ---------------------------------------------------------------------------
# Git 設定
# ---------------------------------------------------------------------------

# 自動コミットの有効/無効
# true にすると、各反復後に変更を自動コミットする。
AUTO_COMMIT=true

# ブランチ名のプレフィックス
# ループ開始時に {BRANCH_PREFIX}-YYYYMMDD-HHMMSS 形式のブランチを作成する。
BRANCH_PREFIX="feature/loop"

# ---------------------------------------------------------------------------
# ログ設定
# ---------------------------------------------------------------------------

# ログの出力先ディレクトリ
# 各反復の Claude 出力がここに保存される。
LOG_DIR=".claude/loop/logs"

# 詳細ログの有効/無効
# true にすると、プロンプト長やスキップ理由など追加情報を出力する。
VERBOSE=false

# ---------------------------------------------------------------------------
# Discord 通知
# ---------------------------------------------------------------------------

# 各イテレーション完了時に Discord に通知を送信する
# Webhook URL の作成方法:
#   Discord サーバー設定 → 連携サービス → ウェブフック → 新しいウェブフック
DISCORD_NOTIFY_ENABLED=false
# DISCORD_WEBHOOK_URL=""  # または環境変数 DISCORD_WEBHOOK_URL で設定
